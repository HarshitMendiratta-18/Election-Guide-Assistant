{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server.js"
    },
    {
      "src": "/(index.html)?",
      "dest": "/public/index.html"
    },
    {
      "src": "/register.html",
      "dest": "/public/register.html"
    },
    {
      "src": "/booth-finder.html",
      "dest": "/public/booth-finder.html"
    },
    {
      "src": "/vote.html",
      "dest": "/public/vote.html"
    },
    {
      "src": "/results.html",
      "dest": "/public/results.html"
    },
    {
      "src": "/quiz.html",
      "dest": "/public/quiz.html"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
