# ElectionGuide Pro - Configuration Template
# Duplicate this file to .env and fill in your actual credentials

# --- Server Config ---
PORT=3000
NODE_ENV=production
SESSION_SECRET=your_ultra_secure_secret_here_99_percent

# --- Google Cloud Platform ---
# Path to your service account key JSON file
GOOGLE_APPLICATION_CREDENTIALS=./config/gcp-key.json
GOOGLE_CLOUD_PROJECT=your-project-id

# --- Firebase Config ---
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@xxxx.iam.gserviceaccount.com

# --- Monitoring ---
GOOGLE_ANALYTICS_ID=G-XXXXXXX
